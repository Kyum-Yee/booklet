#!/bin/bash
cd "$(dirname "$0")"

if command -v python3 &>/dev/null; then
    python3 booklet.py serve
else
    echo "======================================================================"
    echo "  [안내] booklet을 실행하려면 'Python 3(파이썬)'이 필요합니다."
    echo "======================================================================"
    echo ""
    echo "  컴퓨터에 아직 파이썬이 설치되어 있지 않습니다."
    echo "  공식 다운로드 페이지를 열어 드립니다."
    echo "  설치 완료 후 다시 이 파일을 더블 클릭해 주세요!"
    echo ""
    echo "======================================================================"
    open "https://www.python.org/downloads/"
    read -p "엔터를 누르면 창이 닫힙니다..."
fi
